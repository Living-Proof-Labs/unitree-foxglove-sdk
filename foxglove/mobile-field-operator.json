{
  "configById": {
    "Indicator!health": {
      "path": "/health/state.state",
      "style": "background",
      "fallbackColor": "#607d8b",
      "fallbackLabel": "health: no data",
      "rules": [
        { "operator": "=", "rawValue": "incident", "color": "#e53935", "label": "INCIDENT" },
        { "operator": "=", "rawValue": "degraded", "color": "#f9a825", "label": "degraded" },
        { "operator": "=", "rawValue": "nominal", "color": "#43a047", "label": "nominal" },
        { "operator": "=", "rawValue": "inactive", "color": "#607d8b", "label": "inactive" },
        { "operator": "=", "rawValue": "offline", "color": "#424242", "label": "offline" }
      ]
    },
    "Indicator!nav": {
      "path": "/nav/state.state",
      "style": "background",
      "fallbackColor": "#607d8b",
      "fallbackLabel": "nav: no data",
      "rules": [
        { "operator": "=", "rawValue": "arrived", "color": "#43a047", "label": "ARRIVED" },
        { "operator": "=", "rawValue": "walking", "color": "#00897b", "label": "walking" },
        { "operator": "=", "rawValue": "aligning", "color": "#26a69a", "label": "aligning" },
        { "operator": "=", "rawValue": "blind", "color": "#f9a825", "label": "blind" },
        { "operator": "=", "rawValue": "stopped", "color": "#e53935", "label": "stopped" },
        { "operator": "=", "rawValue": "idle", "color": "#607d8b", "label": "idle" }
      ]
    },
    "CallService!stand": {
      "serviceName": "loco/stand",
      "requestPayload": "{}",
      "layout": "vertical",
      "editingMode": false,
      "buttonText": "1  Stand",
      "buttonTooltip": "Ramp every joint to the default pose, still hanging",
      "buttonColor": "#3f51b5"
    },
    "CallService!start": {
      "serviceName": "loco/start",
      "requestPayload": "{}",
      "layout": "vertical",
      "editingMode": false,
      "buttonText": "2  Start",
      "buttonTooltip": "Walking policy at zero velocity, still hanging",
      "buttonColor": "#43a047"
    },
    "CallService!band_lower": {
      "serviceName": "sim/band_lower",
      "requestPayload": "{}",
      "layout": "vertical",
      "editingMode": false,
      "buttonText": "3  Lower",
      "buttonTooltip": "Tap seven times. Feet touch at about the seventh",
      "buttonColor": "#607d8b"
    },
    "CallService!band_release": {
      "serviceName": "sim/band_release",
      "requestPayload": "{}",
      "layout": "vertical",
      "editingMode": false,
      "buttonText": "4  Release",
      "buttonTooltip": "Rope off. The robot stands, then drive with Teleop",
      "buttonColor": "#43a047"
    },
    "CallService!pause": {
      "serviceName": "loco/pause",
      "requestPayload": "{}",
      "layout": "vertical",
      "editingMode": false,
      "buttonText": "Pause",
      "buttonTooltip": "Balance in place and ignore Teleop",
      "buttonColor": "#f9a825"
    },
    "CallService!resume": {
      "serviceName": "loco/resume",
      "requestPayload": "{}",
      "layout": "vertical",
      "editingMode": false,
      "buttonText": "Resume",
      "buttonTooltip": "Teleop drives again",
      "buttonColor": "#43a047"
    },
    "Teleop!cmd_vel": {
      "topic": "/cmd_vel",
      "publishRate": 5,
      "upButton": { "field": "linear-x", "value": 0.4 },
      "downButton": { "field": "linear-x", "value": -0.4 },
      "leftButton": { "field": "angular-z", "value": 0.6 },
      "rightButton": { "field": "angular-z", "value": -0.6 }
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": { "speed": 1 },
  "layout": {
    "direction": "column",
    "splitPercentage": 22,
    "first": {
      "direction": "column",
      "splitPercentage": 50,
      "first": "Indicator!health",
      "second": "Indicator!nav"
    },
    "second": {
      "direction": "column",
      "splitPercentage": 48,
      "first": {
        "direction": "column",
        "splitPercentage": 34,
        "first": {
          "direction": "row",
          "first": "CallService!stand",
          "second": "CallService!start"
        },
        "second": {
          "direction": "column",
          "splitPercentage": 50,
          "first": {
            "direction": "row",
            "first": "CallService!band_lower",
            "second": "CallService!band_release"
          },
          "second": {
            "direction": "row",
            "first": "CallService!pause",
            "second": "CallService!resume"
          }
        }
      },
      "second": "Teleop!cmd_vel"
    }
  }
}
