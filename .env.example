# Copy to .env. That file is gitignored. Do not commit a token.
# Create the token in the Foxglove project. One token belongs to one Foxlet.
# A token that is not already tied to a device needs FOXGLOVE_DEVICE_NAME;
# Foxlet creates that device on first start. The compose default is g1-sim.
FOXGLOVE_DEVICE_TOKEN=
# FOXGLOVE_DEVICE_NAME=g1-sim
